# Server-only Gemini API key. Never expose this through Vite or client code.
GEMINI_API_KEY=
# Supported hosted Gemma 4 model. The documented image-capable default is below.
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=8787
# Leave empty for the single-origin Render deployment. For a separately hosted
# frontend, set this to its exact public origin (comma-separated origins work).
CLIENT_ORIGIN=
# Optional public API origin for a separately hosted frontend. Leave empty for same-origin Render hosting.
VITE_API_BASE_URL=
VITE_REPOSITORY_URL=
